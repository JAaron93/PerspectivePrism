{
  "name": "perspective-prism-chrome-extension",
  "version": "0.2.0",
  "description": "Chrome extension for analyzing YouTube videos with Perspective Prism",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:integration": "playwright test -c tests/integration/playwright.config.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "vite build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.308",
    "@vitest/coverage-v8": "^4.1.11",
    "archiver": "^8.0.0",
    "clean-css": "^5.3.3",
    "eslint": "^9.16.0",
    "jsdom": "^27.0.1",
    "msw": "^2.15.0",
    "playwright": "^1.63.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "dompurify": "^3.4.15"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.4"
    }
  }
}
