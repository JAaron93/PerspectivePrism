{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "types": ["chrome"]
  },
  "include": ["**/*.js", "globals.d.ts"],
  "exclude": ["node_modules", "dist", "coverage", "build.js", "tests", "scripts", "vendor", "vite.config.js"]
}
