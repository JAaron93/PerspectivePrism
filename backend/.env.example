# Project Settings
PROJECT_NAME="Perspective Prism MVP"

# Google Cloud Vertex AI Configuration (Exclusively uses GCP billing credits via Vertex AI)
# GCP_PROJECT: Your billing-enabled GCP Project ID (uses GCP trial/billing credits)
GCP_PROJECT=
# GCP_LOCATION: Vertex AI deployment region ('global' or e.g. 'us-central1')
GCP_LOCATION=global
# GEMINI_TIER: Concurrency throttle mode ('paid' for 10 concurrent calls / 300+ RPM via GCP billing)
GEMINI_TIER=paid

# Model Selection (Gemini 3.x Series)
LLM_MODEL=gemini-3.5-flash-lite
BACKUP_LLM_MODEL=gemini-3.1-flash-lite
MAX_CLAIMS_PER_ANALYSIS=15

# Reliability Settings
CIRCUIT_BREAKER_FAIL_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT=60

# Google Search API Settings
# Get these from Google Cloud Console (Custom Search JSON API)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CSE_ID=your-custom-search-engine-id-here
SEARCH_PROVIDER=google

# CORS Settings
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,chrome-extension://nanlbdgphpjpdmIbfinajkhglclanlfe"
