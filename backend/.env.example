# Project Settings
PROJECT_NAME="Perspective Prism MVP"

# Google Cloud Vertex AI Configuration (Gemini Paid Tier via GCP Billing Credits)
# GCP_PROJECT: Your billing-enabled GCP Project ID (uses GCP trial/billing credits)
GCP_PROJECT=your_gcp_project_id_here
# GCP_LOCATION: Vertex AI deployment region ('global' or e.g. 'us-central1')
GCP_LOCATION=global
# GEMINI_TIER: Controls LLM API concurrency throttle and quota mode.
#   'paid'     → 10 concurrent LLM calls (300+ RPM via GCP billing credits)
#   'standard' → 4 concurrent LLM calls (moderate throughput)
#   'free'     → 2 concurrent LLM calls (throttled to avoid 429 rate-limit errors)
GEMINI_TIER=paid

# Legacy / Alternative LLM API Configuration (AI Studio Key Mode)
# Set GEMINI_API_KEY if running without GCP Vertex AI
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
MAX_CLAIMS_PER_ANALYSIS=15

# Backup / Fallback Configuration
BACKUP_LLM_API_KEY=your_backup_gemini_api_key_here
BACKUP_LLM_MODEL=gemini-3.1-flash-lite

# Reliability Settings
CIRCUIT_BREAKER_FAIL_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT=60

# Google Search API Settings
# Get these from Google Cloud Console (Custom Search JSON API)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CSE_ID=your-custom-search-engine-id-here
SEARCH_PROVIDER=google

# CORS Settings
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,chrome-extension://nanlbdgphpjpdmIbfinajkhglclanlfe"
